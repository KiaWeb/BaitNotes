<Window x:Class="BaitNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaitNotes"
        Width="1019" Height="450"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#202020">

    <Grid>
        <Border CornerRadius="10"
                BorderBrush="#404040"
                BorderThickness="2"
                Background="#252525"
                Margin="10,10,537,10"
                SnapsToDevicePixels="True">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                <ItemsControl x:Name="MyItemsControl"
                              RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="0.061"/>
                            <RotateTransform/>
                            <TranslateTransform Y="0.413"/>
                        </TransformGroup>
                    </ItemsControl.RenderTransform>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border CornerRadius="10"
                BorderBrush="#404040"
                BorderThickness="2"
                Background="#252525"
                Margin="631,10,10,10"
                SnapsToDevicePixels="True">
            <Canvas Background="#202020" x:Name="MainCanvas">
                <Image x:Name="profile"
           Width="128"
           Height="128"
           Canvas.Left="104"
           Canvas.Top="20"/>
                <TextBlock TextWrapping="Wrap"
           Text="Click on a scammer to begin"
           Opacity="1"
           x:Name="scammerName"
           FontSize="24" Canvas.Left="10" Canvas.Top="173" HorizontalAlignment="Center" VerticalAlignment="Center" Width="316" TextAlignment="Center" Foreground="White"/>
                <TextBlock TextWrapping="Wrap"
                    Text="... or add a scammer"
                    Opacity="1"
                    x:Name="scammerNumber"
                    FontSize="16" Canvas.Left="10" Canvas.Top="205" Width="316" TextAlignment="Center" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Button Content="Start Session"
        Width="164"
        Height="40"
        Background="#FF13A713"
        Foreground="White"
        BorderThickness="0"
        Canvas.Left="86"
        Canvas.Top="231"
        FontSize="24"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Click="Session_Start"
        Opacity="0"
        x:Name="startSessionButton"
        IsHitTestVisible="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
            Background="{TemplateBinding Background}"
            CornerRadius="10"
            Opacity="{TemplateBinding Opacity}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>


            </Canvas>
        </Border>
        <Button Content="Add..." HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Width="80" Click="Add_Click" FontSize="25" Background="#FF13A713" Margin="510,0,0,0"/>
    </Grid>
</Window>
