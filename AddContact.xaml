<Window x:Class="BaitNotes.AddContact"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BaitNotes"
        mc:Ignorable="d"
        Title="Add a Contact.." Height="328" Width="228" Background="#252525" ResizeMode="CanMinimize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="401*"/>
            <ColumnDefinition Width="49*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="NameBox"
                 HorizontalAlignment="Left"
                 Height="29"
                 Margin="69,24,0,0"
                 TextWrapping="Wrap"
                 Text=""
                 VerticalAlignment="Top"
                 Width="120"
                 TextChanged="TextBox_TextChanged"/>

        <TextBox x:Name="NumberBox"
                 HorizontalAlignment="Left"
                 Height="29"
                 Margin="69,63,0,0"
                 TextWrapping="Wrap"
                 Text=""
                 VerticalAlignment="Top"
                 Width="120"/>

        <Label Content="Name"
               HorizontalAlignment="Left"
               Height="29"
               Margin="10,24,0,0"
               VerticalAlignment="Top"
               Width="59"
               Foreground="#FFFFFF"/>

        <Label Content="Number"
               HorizontalAlignment="Left"
               Height="29"
               Margin="10,63,0,0"
               VerticalAlignment="Top"
               Width="59"
               Foreground="#FFFFFF"/>

        <Label Content="Status"
               HorizontalAlignment="Left"
               Height="29"
               Margin="10,108,0,0"
               VerticalAlignment="Top"
               Width="59"
               Foreground="#FFFFFF"/>

        <ComboBox x:Name="StatusBox"
                  HorizontalAlignment="Left"
                  Margin="69,106,0,0"
                  VerticalAlignment="Top"
                  Width="120"
                  SelectionChanged="ComboBox_SelectionChanged"
                  Height="33">

            <ComboBoxItem Content="Operating"/>
            <ComboBoxItem Content="Busy Line"/>
            <ComboBoxItem Content="Closed"/>
            <ComboBoxItem Content="Permanently Shutdown"/>

        </ComboBox>

        <Button Content="Finish"
                HorizontalAlignment="Left"
                Margin="26,215,0,0"
                VerticalAlignment="Top"
                Height="46"
                Width="163"
                Click="Button_Click"
                Background="#FF13A713"/>
        <Label Content="Color"
            HorizontalAlignment="Left"
            Height="29"
            Margin="10,154,0,0"
            VerticalAlignment="Top"
            Width="59"
            Foreground="#FFFFFF"/>
        <ComboBox x:Name="StatusBox_Copy"
            HorizontalAlignment="Left"
            Margin="69,152,0,0"
            VerticalAlignment="Top"
            Width="120"
            SelectionChanged="ComboBox_SelectionChanged"
            Height="33">

            <ComboBoxItem Content="Blue"/>
            <ComboBoxItem Content="Green"/>
            <ComboBoxItem Content="Red"/>
            <ComboBoxItem Content="Yellow"/>
            <ComboBoxItem Content="Purple"/>
            <ComboBoxItem Content="Gray"/>
        </ComboBox>

    </Grid>
</Window>