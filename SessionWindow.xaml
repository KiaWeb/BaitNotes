<Window x:Class="BaitNotes.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BaitNotes"
        mc:Ignorable="d"
        Title="Session Recorder"
        Height="409"
        Width="500"
        Background="#252525"
        ResizeMode="CanMinimize">

    <Grid>

        <TextBlock Text="Session Notes"
                   Foreground="White"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   Margin="20,15,0,0"
                   VerticalAlignment="Top"/>

        <TextBox x:Name="NotesBox"
                 HorizontalAlignment="Left"
                 Margin="20,50,0,0"
                 VerticalAlignment="Top"
                 Width="440"
                 Height="120"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"/>

        <TextBlock Text="Desktop Audio Device"
                   Foreground="White"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   Margin="20,185,0,0"
                   VerticalAlignment="Top"/>

        <ComboBox x:Name="AudioDeviceBox"
                  HorizontalAlignment="Left"
                  Margin="20,220,0,0"
                  VerticalAlignment="Top"
                  Width="300"
                  Height="35"/>
        <TextBlock Text="Background Music"
           Foreground="White"
           FontSize="18"
           HorizontalAlignment="Left"
           Margin="20,265,0,0"
           VerticalAlignment="Top"/>

        <ComboBox x:Name="BgmBox"
          HorizontalAlignment="Left"
          Margin="20,295,0,0"
          VerticalAlignment="Top"
          Width="300"
          Height="35"
          SelectionChanged="BgmBox_SelectionChanged">
            <ComboBoxItem Content="None"/>
            <ComboBoxItem Content="Desert"/>
            <ComboBoxItem Content="Water"/>
            <ComboBoxItem Content="Custom"/>
        </ComboBox>

        <Button x:Name="RecordButton"
                Content="● Record"
                HorizontalAlignment="Left"
                Margin="340,220,0,0"
                VerticalAlignment="Top"
                Width="120"
                Height="35"
                FontSize="16"
                Foreground="White"
                Background="#AA2222"
                Click="RecordButton_Click"/>

        <TextBlock x:Name="StatusText"
                   Text="Idle"
                   Foreground="LightGreen"
                   FontSize="16"
                   Margin="155,15,64,0"
                   VerticalAlignment="Top" RenderTransformOrigin="-0.148,0.335" Height="24"/>

    </Grid>
</Window>